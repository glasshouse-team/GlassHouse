{
  "name": "glasshouse",
  "version": "0.1.0",
  "private": true,
  "description": "Glasshouse: Airbnb rebuilt as if AI was there from day one. Hackathon Track 01.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "demo:reset": "tsx --env-file-if-exists=.env.local scripts/reset-demo.ts",
    "video:prepare": "tsx scripts/prepare-video.ts",
    "worlds": "tsx --env-file-if-exists=.env.local scripts/generate-worlds.ts",
    "xray": "tsx --env-file-if-exists=.env.local scripts/run-xray.ts",
    "gaps": "tsx --env-file-if-exists=.env.local scripts/run-gaps.ts",
    "floorplans": "tsx --env-file-if-exists=.env.local scripts/build-floorplans.ts",
    "reviews:split": "tsx --env-file-if-exists=.env.local scripts/split-reviews.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/react": "^4.0.147",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sparkjsdev/spark": "^2.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "simplify-js": "^1.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
