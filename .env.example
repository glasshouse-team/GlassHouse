# Copy to .env.local (never commit .env.local). Share real keys privately, never in git or Jira.
# Full setup steps: docs/SETUP.md

# --- AI: Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
MODEL_AGENT=claude-sonnet-5-5
MODEL_BULK=claude-haiku-5-5

# --- 3D: World Labs Marble (platform.worldlabs.ai) ---
WORLDLABS_API_KEY=
MARBLE_MODEL=marble-1.1-plus

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Georgian speech-to-text (GH-25)
ELEVENLABS_API_KEY=
# Backup 3D path: Tencent HY World on Scenario (only if GH-3 picks it)
SCENARIO_API_KEY=

# --- Demo ---
# true = never call World Labs, use saved world versions, slow negotiation turns (GH-26)
DEMO_MODE=false
